# PaperAgent OPEA cloud example configuration.
# Copy this file to .env and fill in your own endpoint/model/key.
# Never commit .env or real credentials.

# User-supplied OpenAI-compatible cloud LLM settings.
# LLM_ENDPOINT should be the provider root URL without a trailing /v1 for
# the official OPEA TextGen service.
LLM_ENDPOINT=
LLM_MODEL_ID=
OPENAI_API_KEY=

# OPEA service image. Override only when you intentionally pin another build.
OPEA_LLM_IMAGE=opea/llm-textgen:latest

PAPERAGENT_RETRIEVER_PORT=7011
PAPERAGENT_PROMPT_PORT=7012
PAPERAGENT_LLM_PORT=9000
PAPERAGENT_OPEA_GATEWAY_PORT=7008
PAPERAGENT_TOP_K=3
PAPERAGENT_RETRIEVER_TEXT_CHARS=5000
LOGFLAG=False
